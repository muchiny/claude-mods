{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "PROPS_SEED=42 bun test --timeout 120000 ./mode-clair/tests/pure ./tests/golden ./tests/props ./tests/width"
  },
  "coverageAnalysis": "off",
  "mutate": ["mode-clair/hooks/**/*.ts", "!mode-clair/hooks/tools.generated.ts"],
  "concurrency": 2,
  "timeoutMS": 3000,
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation-pure/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-pure/mutation.json"
  },
  "thresholds": {
    "high": 100,
    "low": 90,
    "break": 100
  },
  "tsconfigFile": "tsconfig.stryker-absent.json"
}

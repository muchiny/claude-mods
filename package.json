{
  "name": "claude-mods",
  "private": true,
  "version": "0.0.0",
  "description": "Mods Claude Code de muchiny : outillage de développement (lint, types, mutation).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome ci .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json",
    "validate": "claude plugin validate . && claude plugin validate mode-clair",
    "test": "claude plugin test mode-clair",
    "mutate": "stryker run",
    "coverage": "bun test mode-clair/tests/pure --coverage",
    "test:dev": "bun test ./tests",
    "props": "bun test ./tests/props --timeout 600000",
    "test:golden": "bun test ./tests/golden",
    "golden:update": "GOLDEN_UPDATE=1 bun test ./tests/golden",
    "mutate:pure": "stryker run stryker.pure.json",
    "mutate:module": "node dev/mutate-module.mjs",
    "mutate:gate": "node dev/mutation-gate.mjs",
    "replay:extract": "bun dev/replay/extract.ts",
    "replay:reduce": "bun dev/replay/reduce-run.ts",
    "paint": "node --experimental-strip-types dev/paint/drive.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@stryker-mutator/core": "10.0.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/headless": "5.5.0",
    "bun": "1.4.3",
    "fast-check": "4.10.2",
    "node-pty": "1.1.0",
    "string-width": "8.3.0",
    "typescript": "7.0.2"
  }
}
